version: "3.8"

services:
  semaphore-db:
    image: postgres:14-alpine
    environment:
      POSTGRES_USER: semaphore
      POSTGRES_PASSWORD: connect
      POSTGRES_DB: semaphore
    volumes:
      - semaphore-db:/var/lib/postgresql/data
    networks:
      - backend
    deploy:
      mode: replicated
      replicas: 1

  semaphore:
    image: semaphoreui/semaphore:v2.19.17
    environment:
      SEMAPHORE_DB_DIALECT: postgres
      SEMAPHORE_DB_HOST: semaphore-db
      SEMAPHORE_DB_PORT: 5432
      SEMAPHORE_DB_USER: semaphore
      SEMAPHORE_DB_PASS: connect
      SEMAPHORE_DB: semaphore
      SEMAPHORE_ADMIN: admin
      SEMAPHORE_ADMIN_LOGIN: admin
      SEMAPHORE_ADMIN_PASSWORD: connect
      SEMAPHORE_ADMIN_NAME: Admin
      SEMAPHORE_ADMIN_EMAIL: admin@nverse.local

    networks:
      - traefik-public
      - backend

    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager

      labels:
        - "traefik.enable=true"
        - "traefik.http.routers.semaphore.rule=Host(`semaphore.nverse.local`)"
        - "traefik.http.routers.semaphore.entrypoints=web"
        - "traefik.http.services.semaphore.loadbalancer.server.port=3000"
        - "traefik.docker.network=traefik-public"

volumes:
  semaphore-db:
    driver: local
    driver_opts:
      type: nfs
      o: addr=10.0.39.30,rw,noatime,rsize=1048576,wsize=1048576,tcp,timeo=14,nfsvers=4
      device: ":/srv/nfs/semaphore"

networks:
  traefik-public:
    external: true
  backend:
    driver: overlay
