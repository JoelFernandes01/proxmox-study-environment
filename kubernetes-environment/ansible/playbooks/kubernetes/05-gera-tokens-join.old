---
- name: Gerar tokens e certificados no primeiro control-plane
  hosts: k8s-control-plane-01
  become: true
  gather_facts: false
  tasks:
    - name: Gerar certificate-key para control-plane
      command: kubeadm init phase upload-certs --upload-certs
      register: cert_output

    - name: Extrair certificate key
      set_fact:
        certificate_key: "{{ cert_output.stdout_lines[-1] }}"

    - name: Gerar join command basico
      command: kubeadm token create --print-join-command
      register: join_cmd_basic

    - name: Definir comandos de join em memoria (hostvars)
      set_fact:
        join_control_plane_cmd: "{{ join_cmd_basic.stdout }} --control-plane --certificate-key {{ certificate_key }}"
        join_worker_cmd: "{{ join_cmd_basic.stdout }}"

    - name: Salvar backup dos tokens em arquivo remoto
      copy:
        dest: /home/connect/join-info.yml
        content: |
          join_control_plane_cmd: "{{ join_cmd_basic.stdout }} --control-plane --certificate-key {{ certificate_key }}"
          join_worker_cmd: "{{ join_cmd_basic.stdout }}"
        owner: connect
        group: connect
        mode: '0600'
